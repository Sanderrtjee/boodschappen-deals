# Alleen voor draaien buiten Home Assistant, met docker compose.
#
# Waarom een apart Dockerfile: het Home Assistant basisimage draait op
# s6-overlay met ENTRYPOINT ["/init"] en heeft bashio. Buiten Home Assistant is
# dat overbodig, en dan is een kaal Node-image simpeler. De applicatiecode is
# identiek, en `pg` komt hier net zo uit de meegeleverde node_modules.
FROM node:22.20-alpine3.21

RUN addgroup -g 10001 -S app && adduser -u 10001 -S app -G app

WORKDIR /app
COPY app/ ./

RUN mkdir -p /data && chown -R app:app /data /app
USER app

ENV NODE_ENV=production \
    PORT=8499 \
    DATA_DIR=/data

EXPOSE 8499

HEALTHCHECK --interval=60s --timeout=5s --start-period=15s \
  CMD node -e "fetch('http://127.0.0.1:8499/api/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"

CMD ["node", "server.js"]
